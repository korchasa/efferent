{
  // The bucket service and its keyless remote MCP endpoint. Nothing here can
  // decrypt an archive; only ciphertext and public signing keys reach R2.
  "name": "efferent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  // Its own hostname in a zone this account owns, rather than a `workers.dev`
  // address: an address that ships inside an App Store binary cannot be moved
  // afterwards, and only a real zone can carry a firewall rule. The service
  // lives at api.efferentapp.com since 2026-09-07, before any build reached a
  // stranger; the app's public site is the apex of that zone.
  // The old host, efferent.korchasa.dev, was routed here as well until the
  // owner's phone carried a build that knew the new one (the app follows the
  // address in its build on launch, so the move cost one install); the first
  // upload on the new host was seen on 2026-09-07 and the old routes went. The
  // old name still exists as a redirect to the site.
  // Said out loud rather than left to wrangler, which disables the workers.dev
  // name by itself as soon as a route exists: the old address answering 404 is
  // the intended end of the move, not a side effect to rediscover later.
  "workers_dev": false,
  "routes": [
    { "pattern": "api.efferentapp.com/*", "zone_name": "efferentapp.com" }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "efferent"
    }
  ],
  // Two counts, kept apart because a phone claims its bucket once in its life
  // and then uploads for years. Cloudflare counts these within one of its
  // locations, so they thin a flood rather than cap it; the ceilings in the
  // code are what bound the bill.
  "ratelimits": [
    {
      "name": "CLAIMS",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // A decade of history goes up in about 120 requests, four in the air at
      // once, so a first export needs a couple of hundred in a minute.
      "name": "WRITES",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      // An agent submits an edit when it has something to say, a few times an
      // hour at most; sixty a minute is room for a script that batches badly
      // and a wall for one that loops.
      "name": "EDITS",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  // A second, separate service for the dev copy of the app (bundle id ending
  // in `.dev`, installed next to the store build). Its own host, its own
  // bucket and its own APP_ID secret, so nothing a development build does can
  // land beside the archive the phone relies on. Wrangler inherits nothing
  // that binds (routes, buckets, rate limits, secrets), so they are repeated;
  // the rate-limit namespaces are per account, hence different ids.
  // Deploy with `wrangler deploy --env dev`; the Worker is named efferent-dev.
  "env": {
    "dev": {
      "routes": [
        { "pattern": "api-dev.efferentapp.com/*", "zone_name": "efferentapp.com" }
      ],
      "r2_buckets": [
        { "binding": "BLOBS", "bucket_name": "efferent-dev" }
      ],
      "ratelimits": [
        { "name": "CLAIMS", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
        { "name": "WRITES", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } },
        { "name": "EDITS", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } }
      ],
      "observability": { "enabled": true }
    }
  }
}

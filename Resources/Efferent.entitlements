<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read access to Health. The types themselves are requested at runtime. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- Lets HealthKit wake the app when new records land. Without it the app
	     only ever sees new data when the person opens it by hand. -->
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
	<!-- Lets the archive's own service wake this phone when an agent has put an
	     edit in the queue. The push carries nothing and shows nothing; it is a
	     moment of being awake, and the phone decides the rest.

	     The value here declares that the app uses push; it does not choose the
	     environment. That comes from the provisioning profile the build is
	     signed with, which is the only thing that can be right about it: a
	     development profile carries `development`, a distribution one carries
	     `production`, and this repo cannot know which of the two is being
	     built. Signing takes the profile's value and refuses a build whose
	     profile names no push environment at all — a build signed for the
	     wrong Apple is accepted, installs, runs, and is simply never woken. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>

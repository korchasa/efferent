{
  "name": "efferent",
  "version": "1.0.0",
  "exports": {},
  "tasks": {
    "check": "deno run -A scripts/check.ts",
    "test": "deno run -A scripts/test.ts",
    "mcp": "deno run -A scripts/reader-run.ts efferent.mcp",
    "dist": "deno run -A scripts/dist.ts",
    "fmt": "deno run -A scripts/fmt.ts",
    "secrets": "deno run -A scripts/secrets.ts",
    "generate": "deno run -A scripts/generate.ts",
    "efferent": "deno run -A scripts/reader-run.ts efferent",
    "interop": "deno run -A scripts/interop.ts",
    "reader:setup": "deno run -A scripts/reader.ts",
    "test:reader": "deno run -A scripts/test-reader.ts",
    "icons": "deno run -A scripts/icons.ts",
    "screenshots": "deno run -A scripts/screenshots.ts"
  },
  "fmt": {
    "include": [
      "scripts/",
      "deno.json"
    ],
    "lineWidth": 100
  },
  "lint": {
    "include": [
      "scripts/"
    ]
  }
}
